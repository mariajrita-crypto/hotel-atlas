<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<StackPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.LoginController">
    <HBox>
        <!-- Capa: foto + camada azul, como no primeiro slide -->
        <StackPane HBox.hgrow="ALWAYS" styleClass="login-hero" minWidth="0">
            <ImageView fitWidth="1400" fitHeight="1000" preserveRatio="false" opacity="0.45" StackPane.alignment="CENTER">
                <image><Image url="@imagens/quartos/quarto-401.jpg"/></image>
            </ImageView>
            <VBox alignment="CENTER" spacing="10">
                <Label text="★★★★★" styleClass="hero-stars"/>
                <Label text="ATLAS" styleClass="brand-title"/>
                <Label text="Carregamos o seu conforto nas costas." styleClass="hero-tagline"/>
            </VBox>
        </StackPane>
        <!-- Formulário -->
        <StackPane styleClass="login-panel" minWidth="520" prefWidth="560" maxWidth="560">
            <VBox alignment="CENTER_LEFT" spacing="14" maxWidth="420" styleClass="login-card" style="-fx-background-color: transparent;">
                <Label text="BEM-VINDO" styleClass="form-heading"/>
                <Label text="Sua estadia começa aqui" styleClass="subtitle"/>
                <TabPane fx:id="authTabs" tabClosingPolicy="UNAVAILABLE" maxWidth="420" styleClass="auth-tabs">
                <tabs>
                    <Tab text="Entrar">
                        <content>
                            <VBox spacing="13">
                                <padding><Insets top="18" right="4" bottom="8" left="4"/></padding>
                                <Label text="Acesse sua conta" styleClass="section-title"/>
                                <VBox spacing="6"><Label text="Tipo de acesso"/><ComboBox fx:id="cbPerfil" maxWidth="Infinity"/></VBox>
                                <VBox spacing="6"><Label text="CPF / e-mail do funcionário"/><TextField fx:id="txtIdentificador" promptText="Seu CPF (somente números)"/></VBox>
                                <VBox spacing="6"><Label text="Senha"/><PasswordField fx:id="txtSenha" promptText="Digite sua senha" onAction="#entrar"/></VBox>
                                <Label fx:id="lblErro" wrapText="true" styleClass="error-text"/>
                                <Button text="Entrar" onAction="#entrar" maxWidth="Infinity" styleClass="btn-primary"/>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="Criar conta">
                        <content>
                            <VBox spacing="12">
                                <padding><Insets top="18" right="4" bottom="8" left="4"/></padding>
                                <Label text="Cadastro de cliente" styleClass="section-title"/>
                                <VBox spacing="5"><Label text="CPF"/><TextField fx:id="txtCpfCadastro" promptText="Somente os 11 números"/></VBox>
                                <VBox spacing="5"><Label text="Telefone com DDD"/><TextField fx:id="txtTelefoneCadastro" promptText="Ex.: 48999998888"/></VBox>
                                <VBox spacing="5"><Label text="Senha"/><PasswordField fx:id="txtSenhaCadastro" promptText="Mínimo de 8 caracteres"/></VBox>
                                <VBox spacing="5"><Label text="Confirmar senha"/><PasswordField fx:id="txtConfirmarSenha" promptText="Digite a senha novamente" onAction="#cadastrar"/></VBox>
                                <Label fx:id="lblCadastroStatus" wrapText="true" styleClass="status-text"/>
                                <Button text="Criar minha conta" onAction="#cadastrar" maxWidth="Infinity" styleClass="btn-primary"/>
                                <Label text="Cadastro local para demonstração. Use dados fictícios durante os testes." wrapText="true" styleClass="helper-text"/>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab fx:id="tabAdministrador" text="Cadastrar ADM">
                        <content>
                            <VBox spacing="10">
                                <padding><Insets top="14" right="4" bottom="8" left="4"/></padding>
                                <Label text="Configuração inicial do administrador" styleClass="section-title"/>
                                <Label text="Cadastre o primeiro administrador do Atlas Hotel. Depois desse cadastro, esta opção será bloqueada." wrapText="true" styleClass="helper-text"/>
                                <VBox spacing="5"><Label text="Nome completo"/><TextField fx:id="txtNomeAdmin" promptText="Nome do administrador"/></VBox>
                                <VBox spacing="5"><Label text="E-mail"/><TextField fx:id="txtEmailAdmin" promptText="admin@seudominio.com"/></VBox>
                                <VBox spacing="5"><Label text="Senha"/><PasswordField fx:id="txtSenhaAdmin" promptText="Mínimo de 10 caracteres"/></VBox>
                                <VBox spacing="5"><Label text="Confirmar senha"/><PasswordField fx:id="txtConfirmarSenhaAdmin" promptText="Repita a senha"/></VBox>
                                <Label fx:id="lblAdminStatus" wrapText="true" styleClass="status-text"/>
                                <Button text="Cadastrar administrador" onAction="#cadastrarAdministrador" maxWidth="Infinity" styleClass="btn-primary"/>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
            </VBox>
        </StackPane>
    </HBox>
</StackPane>
